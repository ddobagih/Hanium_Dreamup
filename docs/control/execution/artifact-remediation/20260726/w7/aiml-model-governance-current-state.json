        "encoding": "UTF-8",
        "ensure_ascii": false,
        "object_key_order": "LEXICOGRAPHIC_ASCENDING via sort_keys=true",
        "separators": {
          "item": ",",
          "key_value": ":"
        },
        "whitespace": "NONE_EXCEPT_REQUIRED_JSON_STRING_ESCAPES_AND_TRAILING_LF",
        "trailing_lf": true,
        "hash_algorithm": "SHA-256",
        "digest_encoding": "lowercase hexadecimal"
      }
    }
  }
}
