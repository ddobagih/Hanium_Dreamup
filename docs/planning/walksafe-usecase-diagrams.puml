' ============================================================
' WalkSafe 유스케이스 다이어그램  (요구 명세서 2.2)
' 2026-09-13 · 10 UCD · 35 UC + 전체 구성 1장
'
' 렌더링
'   java -jar plantuml.jar -tpng walksafe-usecase-diagrams.puml
'   @startuml 이름마다 PNG 한 장씩 나옵니다. Graphviz가 없어도
'   !pragma layout smetana 가 대신 배치합니다.
'
' 한글 글꼴
'   macOS "Apple SD Gothic Neo" / Windows "Malgun Gothic"
'   글꼴이 없으면 네모로 깨지니 환경에 맞게 바꿔 주세요.
'   (각 다이어그램의 skinparam defaultFontName 줄)
' ============================================================


' ============================================================
@startuml UCD-00-overview
!pragma layout smetana
left to right direction
skinparam defaultFontName "Apple SD Gothic Neo"
skinparam defaultFontSize 13
skinparam shadowing false
skinparam ArrowColor #5b6159
skinparam usecase {
  BackgroundColor #ffffff
  BorderColor #8f5510
  FontColor #17191c
}
skinparam actor {
  BackgroundColor #f6efe3
  BorderColor #8f5510
}
skinparam rectangle {
  BackgroundColor #fbfbf9
  BorderColor #c9cec6
}
skinparam note {
  BackgroundColor #f4f5f2
  BorderColor #c9cec6
}

title WalkSafe 전체 구성

actor "시각장애인\n사용자" as User
actor "지정 관리자" as Admin
actor "시스템" as System
actor "TMAP" as Tmap
actor "SMTP 메일" as Mail

rectangle "WalkSafe 사용자 앱" {
  usecase "UCD-01\n계정·세션 관리" as D1
  usecase "UCD-02\n동의·권한·권리" as D2
  usecase "UCD-03\n기기 점검" as D3
  usecase "UCD-04\n안전 교육" as D4
  usecase "UCD-05\n보행 준비·세션" as D5
  usecase "UCD-06\n위험 안내" as D6
  usecase "UCD-07\n길안내" as D7
  usecase "UCD-08\n음성 상호작용" as D8
  usecase "UCD-09\n신고" as D9
}

rectangle "WalkSafe 관리자 앱" {
  usecase "UCD-10\n관리자" as D10
}

User --> D1
User --> D2
User --> D3
User --> D4
User --> D5
User --> D7
User --> D8
User --> D9
System --> D5
System --> D6
Admin --> D10

D1 ..> Mail : 가입 인증번호
D7 ..> Tmap : 검색·경로
D9 ..> D10 : 접수

note bottom of D3
  첫 실행 순서
  UCD-01 → 02 → 03 → 04 → 05
  기기 점검이 안전 교육보다 먼저
end note
@enduml


