sequenceDiagram
  participant App as "D12 관리자 앱"
  participant API as "D09 middleware와 D14 API"
  participant Proof as "D14 기기 증명"
  participant DB as "PostgreSQL"
  participant Work as "보호 업무"
  App->>API: "POST reauthenticate - exact action path nonce와 새 TOTP"
  API->>DB: "F-D14-019 기존 pending 소비와 새 재확인 저장"
  Note over API,DB: "session step_up_verified_at는 NULL 설정"
  DB-->>App: "expiry와 exact 작업 binding"
  App->>Proof: "F-D14-016 challenge exact13"
  Proof->>DB: "ACTIVE key와 quota 확인 - challenge commit"
  Proof-->>App: "exact18 signing_payload - TTL120초"
  App->>App: "기기 키로 P256 서명"
  App->>API: "보호 요청과 signature correlation body nonce"
  API->>DB: "F-D14-020 NORMAL custody bearer 확인 후 nonce 소비 commit"
  Note over API,DB: "반환 identity에 matched verified_at 재주입 없음"
  API->>Proof: "F-D14-017 실제 raw body와 query 검증"
  alt "ACTION proof 검증 실패"
    Proof-->>App: "오류 - 앞서 소비된 nonce 재사용 불가"
  else "ACTION proof 검증 성공"
    Proof->>DB: "현재 ACTIVE key와 challenge 일회 소비 commit"
    API->>Work: "동일 identity와 proof로 route 호출"
    alt "incident 또는 report route에서 step_up timestamp 없음"
      Work-->>App: "403 admin_step_up_required - 정적 불일치 R-D14-008"
    else "요구된 route 문맥을 통과한 경우"
      Work->>DB: "보호 transaction에서 control과 session 재검증"
      alt "사업 성공"
        Work->>DB: "business와 audit commit"
        Work-->>App: "성공 결과"
      else "사업 실패 또는 recovery 경합"
        Work->>DB: "business rollback"
        Work-->>App: "실패 - commit된 일회 증명은 재사용 불가"
      end
    end
  end
