sequenceDiagram
    participant G as "Gateway"
    participant A as "RAW API"
    participant D as "DB consent와inventory"
    participant F as "암호화파일과journal"
    participant K as "Key manager"
    G->>A: "F-D13-022..024 선택적 HEAD proof"
    A->>D: "동의 chain과tombstone 검사"
    A->>D: "rollback"
    A-->>G: "204 현재 admission"
    G->>A: "F-D13-025 manifest PUT"
    A->>D: "shared fence와capacity예약 후manifest commit"
    A-->>G: "201 또는exactreplay200"
    G->>A: "F-D13-026 chunk PUT"
    A->>A: "length와SHA256검증"
    A->>D: "현재admission 재검사와row lock"
    A->>K: "active key synchronize"
    K-->>A: "encryption slot"
    A->>F: "journal fsync 후envelope publish"
    A->>D: "chunkmetadata commit"
    alt "DB commit 정상"
      A->>F: "matching journal cleanup"
      A-->>G: "chunk ack"
    else "commit 결과 모호"
      A-->>G: "503 저널 보존"
      Note over D,F: "F-D13-030 기동복구가 DB실제상태로 결정"
    end
    G->>A: "F-D13-028 commit POST"
    A->>D: "admission과inventory재검증"
    A->>F: "모든chunk 인증복호화와objectSHA검증"
    A->>D: "QUARANTINED14일과receipt commit"
    A-->>G: "immutable receipt v2"
