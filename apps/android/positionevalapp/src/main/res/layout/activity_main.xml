<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="28dp"
        android:paddingEnd="22dp"
        android:paddingBottom="36dp">

        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityHeading="true"
            android:text="@string/title"
            android:textColor="@color/ink"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:lineSpacingExtra="4dp"
            android:text="@string/intro"
            android:textColor="@color/muted"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="자동 다운로드용 키 (선택)"
            android:textColor="@color/ink"
            android:textSize="20sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/fileKeyInput"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="10dp"
            android:hint="@string/key_label"
            android:importantForAutofill="no"
            android:inputType="textPassword"
            android:saveEnabled="false"
            android:singleLine="true"
            android:textColor="@color/ink"
            android:textColorHint="@color/muted" />

        <TextView
            android:id="@+id/keyState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/key_hint"
            android:textColor="@color/muted"
            android:textSize="14sp" />

        <Button
            android:id="@+id/saveKeyButton"
            style="@style/EvalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/save_key" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="26dp"
            android:background="@color/line" />

        <Button
            android:id="@+id/selectTraceButton"
            style="@style/EvalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="@string/select_trace" />

        <TextView
            android:id="@+id/traceState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/trace_empty"
            android:textColor="@color/muted"
            android:textSize="15sp" />

        <Button
            android:id="@+id/selectGnssButton"
            style="@style/EvalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/select_gnss" />

        <TextView
            android:id="@+id/gnssState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/gnss_empty"
            android:textColor="@color/muted"
            android:textSize="15sp" />

        <Button
            android:id="@+id/selectBaseButton"
            style="@style/EvalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/select_base" />

        <TextView
            android:id="@+id/baseState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/base_empty"
            android:textColor="@color/muted"
            android:textSize="15sp" />

        <Button
            android:id="@+id/analyzeManualButton"
            style="@style/EvalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:enabled="false"
            android:text="@string/start_manual_analysis" />

        <Button
            android:id="@+id/analyzeButton"
            style="@style/EvalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:enabled="false"
            android:text="@string/start_analysis" />

        <Button
            android:id="@+id/cancelButton"
            style="@style/EvalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:enabled="false"
            android:text="분석 취소" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:accessibilityLiveRegion="polite"
            android:background="@color/panel"
            android:lineSpacingExtra="5dp"
            android:padding="18dp"
            android:text="@string/status_ready"
            android:textColor="@color/ink"
            android:textIsSelectable="true"
            android:textSize="17sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/truth_notice"
            android:textColor="@color/warning"
            android:textSize="15sp" />

        <Button
            android:id="@+id/exportButton"
            style="@style/EvalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:enabled="false"
            android:text="@string/export_result" />

        <Button
            android:id="@+id/clearButton"
            style="@style/EvalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/clear_private_data" />
    </LinearLayout>
</ScrollView>
