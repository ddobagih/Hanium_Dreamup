# DRAFT_DEPLOYMENT_EXAMPLE — NOT_APPLIED.
# This file is not an installation record or production configuration.
# If a later deployment is separately approved, copy it to
# /etc/walksafe/android-gateway.env as root:root, chmod 0600, and replace every
# CHANGE_ME value with separately managed secrets or approved immutable values.

NODE_ENV=production
WALKSAFE_ENVIRONMENT=production
WALKSAFE_SOURCE_COMMIT=CHANGE_ME_FULL_40_CHARACTER_GIT_COMMIT

# The Android Gateway is one Node process bound only to loopback. Do not change
# this to 0.0.0.0, ::, a LAN address, or a public address.
WALKSAFE_ANDROID_GATEWAY_HOST=127.0.0.1
WALKSAFE_ANDROID_GATEWAY_PORT=8081

# The protected backend is also loopback-only. Next/Web is not a fallback.
BACKEND_API_BASE_URL=http://127.0.0.1:8000

# Server STT/TTS is fail-closed and disabled until its separately pinned Voice
# service and dedicated token are provisioned. Never put this token in an APK.
WALKSAFE_VOICE_ENABLED=false
WALKSAFE_VOICE_API_BASE_URL=http://127.0.0.1:9001
# WALKSAFE_VOICE_SERVICE_TOKEN=CHANGE_ME_DISTINCT_VOICE_TOKEN_AT_LEAST_24_CHARACTERS
WALKSAFE_VOICE_STT_MAX_BODY_BYTES=10485760
WALKSAFE_VOICE_STT_RESPONSE_MAX_BYTES=65536
WALKSAFE_VOICE_STT_TIMEOUT_MS=35000
WALKSAFE_VOICE_STT_GLOBAL_RATE_LIMIT=120
WALKSAFE_VOICE_STT_ACTOR_RATE_LIMIT=12
WALKSAFE_VOICE_STT_IP_RATE_LIMIT=30
WALKSAFE_VOICE_STT_MAX_CONCURRENCY=1
WALKSAFE_VOICE_TTS_MAX_BODY_BYTES=2048
WALKSAFE_VOICE_TTS_RESPONSE_MAX_BYTES=4194304
WALKSAFE_VOICE_TTS_MAX_AUDIO_DURATION_SECONDS=30
WALKSAFE_VOICE_TTS_TIMEOUT_MS=65000
WALKSAFE_VOICE_TTS_GLOBAL_RATE_LIMIT=120
WALKSAFE_VOICE_TTS_ACTOR_RATE_LIMIT=30
WALKSAFE_VOICE_TTS_IP_RATE_LIMIT=60
WALKSAFE_VOICE_TTS_MAX_CONCURRENCY=1
WALKSAFE_VOICE_RATE_WINDOW_SECONDS=60

# Gateway-to-backend field role credential.
WALKSAFE_FIELD_TEST_TOKEN=CHANGE_ME_DISTINCT_BACKEND_FIELD_TOKEN_AT_LEAST_24_CHARACTERS

# Optional legacy static Android login credentials. Backend email/password
# accounts do not require this variable. If retained, every token must differ
# from the backend field role credential. Never commit real account material.
# WALKSAFE_FIELD_ACCOUNTS_JSON='[{"actor_id":"CHANGE_ME_FIELD_ACTOR","token":"CHANGE_ME_DISTINCT_FIELD_LOGIN_TOKEN_AT_LEAST_24_CHARACTERS"}]'

# Generate a dedicated random session-signing secret of at least 32 characters
# outside Git. It must differ from the Backend field token above.
WALKSAFE_GATEWAY_SESSION_SECRET=CHANGE_ME_RANDOM_SESSION_SECRET_AT_LEAST_32_CHARACTERS

# Default-deny FP011 long-lived field sessions. Keep this false unless a separate
# security/operations approval fixes all three TTLs. There are no implicit TTL
# defaults, and partial or out-of-range values do not enable the long mode.
WALKSAFE_FIELD_LONG_LIVED_SESSIONS_ENABLED=false
# WALKSAFE_FIELD_ACCESS_TTL_SECONDS=CHANGE_ME_APPROVED_INTEGER_60_TO_3600
# WALKSAFE_FIELD_REFRESH_IDLE_TTL_SECONDS=CHANGE_ME_APPROVED_INTEGER_300_TO_7776000
# WALKSAFE_FIELD_REFRESH_ABSOLUTE_TTL_SECONDS=CHANGE_ME_APPROVED_INTEGER_3600_TO_31536000

# nginx overwrites X-Real-IP from the loopback peer. Do not trust an arbitrary
# client-selected header or enable a public direct connection to port 8081.
WALKSAFE_GATEWAY_TRUSTED_IP_HEADER=x-real-ip

# The service account is the only writer. The systemd StateDirectory parent and
# this child directory must remain owner-only (0700).
WALKSAFE_GATEWAY_RATE_LIMIT_DIR=/var/lib/walksafe/android-gateway/rate-limit

# AES-256-GCM state keyring. Keep this outside the writable state directory as
# root:walksafe-android-gateway mode 0640. It must contain exactly one active
# key; decrypt-only keys are rotation inputs, and compromised entries contain
# no key material. Never set the maintenance SERVICE_STOPPED acknowledgement in
# the running service environment.
WALKSAFE_GATEWAY_STATE_KEYRING_FILE=/etc/walksafe/android-gateway-state-keyring.json

# The field-walk ledger is encrypted by the same external keyring. Production
# has no implicit /tmp fallback and refuses startup if this path is absent.
WALKSAFE_FIELD_WALK_LEDGER_PATH=/var/lib/walksafe/android-gateway/field-walk-ledger.json

# Public, app-independent intake page used by /privacy/rights. It must be a
# separately approved HTTPS URL and must remain usable without an app session.
WALKSAFE_PRIVACY_RIGHTS_REQUEST_URL=https://CHANGE_ME_PRIVACY_HOST/rights/request
