# Copy to /etc/walksafe/backend-runtime.env, replace every CHANGE_ME value, set
# owner/group to root:root, and chmod 0600. systemd reads this file before
# dropping privileges; the API process must not be able to reopen it.
WALKSAFE_ENVIRONMENT=production
WALKSAFE_SOURCE_COMMIT=CHANGE_ME_FULL_40_CHARACTER_GIT_COMMIT
WALKSAFE_BACKEND_WORKERS=1
WALKSAFE_BACKEND_REPLICAS=1
WALKSAFE_ACTOR_RATE_LIMIT_STORE=postgresql

# Remote production connections must authenticate the server certificate and force TLS over GSS encryption.
# walksafe_backend_app is a LOGIN role that inherits the migration-created
# NOLOGIN walksafe_backend_runtime privilege group. It must not own schema objects.
DATABASE_URL=postgresql+psycopg://walksafe_backend_app:CHANGE_ME@db.example.invalid:5432/walksafe?sslmode=verify-full&gssencmode=disable
DATABASE_CONNECT_TIMEOUT_SECONDS=5
DATABASE_STATEMENT_TIMEOUT_MS=10000
WALKSAFE_DATABASE_AT_REST_ENCRYPTION_CONFIRMED=true
WALKSAFE_DATABASE_TRANSPORT_SECURITY_CONFIRMED=true
WALKSAFE_DATABASE_ENCRYPTION_KEY_BOUNDARY=CHANGE_ME_DATABASE_KMS_BOUNDARY
WALKSAFE_REPORT_IMAGE_KEY_BOUNDARY=CHANGE_ME_REPORT_IMAGE_KEY_BOUNDARY

# Every backend replica must mount this same durable filesystem namespace.
UPLOAD_DIR=/var/lib/walksafe/uploads
WALKSAFE_UPLOAD_BACKUP_READER_GROUP=walksafe-backup-readers
# Disabled unless an approved interval and TTL are explicitly set together
# with the durable private counter path. The TTL must exceed the interval.
# WALKSAFE_CAPACITY_MEASUREMENT_INTERVAL_SECONDS=CHANGE_ME_APPROVED_POSITIVE_SECONDS
# WALKSAFE_CAPACITY_STATE_TTL_SECONDS=CHANGE_ME_APPROVED_GREATER_POSITIVE_SECONDS
# WALKSAFE_CAPACITY_VERSION_STATE_PATH=/var/lib/walksafe/capacity/version
MAX_UPLOAD_BYTES=8388608
MAX_REPORT_METADATA_BYTES=65536
ANDROID_DEBUG_LOG_ENABLED=false
ANDROID_DEBUG_LOG_DIR=/var/lib/walksafe/android-debug-logs
# Provision this file root:walksafe-backend with mode 0440 or 0640. Its full
# ancestor chain must be root-owned and deny group/other writes.
WALKSAFE_REPORT_IMAGE_KEY_PROVIDER=secret_file
WALKSAFE_REPORT_IMAGE_KEY_FILE=/etc/walksafe/report-image-keyring.json
WALKSAFE_REPORT_IMAGE_KMS_AGENT_SOCKET=
WALKSAFE_REPORT_IMAGE_KMS_AGENT_PEER_UID=0
WALKSAFE_REPORT_IMAGE_KMS_AGENT_TIMEOUT_SECONDS=2.0
WALKSAFE_REPORT_ORIGINAL_GRANT_TTL_SECONDS=120

DETECT_V2_MODE=real
DETECT_V2_IMAGE_SIZE=768
# This hash-approved weight is an external runtime input and is not in the RC archive.
DETECT_V2_UNIFIED_MODEL_PATH=/var/lib/walksafe/models/walksafe_13cls_yolo26n_img768_best_epoch270.pt
DETECT_V2_RUNTIME_CONFIG_PATH=/srv/walksafe/backend/configs/walksafe_unified_epoch270_field_20260711.json
INFERENCE_PROCESS_ISOLATION_ENABLED=true
INFERENCE_TIMEOUT_SECONDS=2.0
INFERENCE_STARTUP_TIMEOUT_SECONDS=30.0

WALKING_ROUTE_PROVIDER=tmap_pedestrian
TMAP_APP_KEY=CHANGE_ME
TMAP_PEDESTRIAN_ROUTE_URL=https://apis.openapi.sk.com/tmap/routes/pedestrian
TMAP_POI_SEARCH_URL=https://apis.openapi.sk.com/tmap/pois
TMAP_POI_PROVIDER=live
TMAP_TIMEOUT_SECONDS=4.0
TMAP_READINESS_LIVE_PROBE_ENABLED=true

CORS_ORIGINS=https://walksafe.example.invalid
WALKSAFE_ALLOW_INSECURE_LOCAL_DEV=false
WALKSAFE_FIELD_TEST_SECURITY_ENABLED=true
WALKSAFE_FIELD_TEST_TOKEN=CHANGE_ME_DEDICATED_FIELD_TOKEN_AT_LEAST_24_CHARACTERS
# Database-backed administrator security is mandatory outside development/test.
# The legacy static administrator token is deliberately empty in this mode.
WALKSAFE_ADMIN_TOKEN=
WALKSAFE_ADMIN_SECURITY_ENABLED=true
WALKSAFE_ADMIN_ID=walksafe.admin
# Replace with a canonical unpadded Base32 seed containing at least 160 bits.
# Keep the seed and recovery material outside Git and outside the administrator phone.
WALKSAFE_ADMIN_TOTP_SECRET=CHANGE_ME_CANONICAL_UNPADDED_BASE32_MIN_160_BITS
# This path contains no key value. Provision a distinct 256-bit key as one
# canonical 43-character unpadded base64url line in a root:walksafe-backend
# 0440 file. Do not reuse a TOTP, recovery, signing, HMAC, or image key.
WALKSAFE_ADMIN_CREDENTIAL_ISSUER_KEY_FILE=/etc/walksafe/admin-credential-issuer.key
WALKSAFE_ADMIN_SESSION_TTL_SECONDS=43200
WALKSAFE_ADMIN_STEP_UP_TTL_SECONDS=300
WALKSAFE_ADMIN_RECOVERY_TTL_SECONDS=900
# Per-source limit; the server also caps aggregate attempts at four times this value.
WALKSAFE_ADMIN_AUTH_RATE_LIMIT_ATTEMPTS=5
WALKSAFE_ADMIN_AUTH_RATE_LIMIT_WINDOW_SECONDS=300
WALKSAFE_GATEWAY_SESSION_SECRET=CHANGE_ME_RANDOM_SESSION_SECRET_AT_LEAST_32_CHARACTERS
# Dedicated privacy pseudonym key. Alembic uses the same value to bind legacy
# named-actor reports before raw actor metadata is removed. Changing either
# value without an explicit keyring migration makes startup/readiness fail closed.
# The value must contain at least 32 bytes when encoded as UTF-8.
WALKSAFE_PRIVACY_HMAC_SECRET=CHANGE_ME_RANDOM_PRIVACY_HMAC_SECRET_AT_LEAST_32_UTF8_BYTES
WALKSAFE_PRIVACY_HMAC_KEY_VERSION=1
WALKSAFE_MAINTENANCE_LOCK_PATH=/run/walksafe-maintenance-lock/maintenance.lock
WALKSAFE_MAINTENANCE_LOCK_GROUP=walksafe-maintenance-lock
