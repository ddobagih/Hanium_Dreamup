# DRAFT / NOT_APPLIED. Copy to /etc/walksafe/backup.env only after review.
# The installed file must be root:root 0600 and must not be committed.
# The service also requires a fresh root:walksafe-backup 0440 exact-content
# /etc/walksafe/backup-writes-quiesced.approved marker. This example does not create it.
DATABASE_URL=postgresql+psycopg://walksafe_backup:CHANGE_ME@127.0.0.1:5432/walksafe
UPLOAD_DIR=/var/lib/walksafe/uploads
WALKSAFE_UPLOAD_BACKUP_READER_GROUP=walksafe-backup-readers
GNUPGHOME=/var/lib/walksafe-backup-gnupg
WALKSAFE_BACKUP_OUTPUT_DIR=/var/lib/walksafe-backup/sets
WALKSAFE_BACKUP_GPG_RECIPIENT=CHANGE_ME_40_HEX_RECIPIENT_FINGERPRINT
WALKSAFE_BACKUP_GPG_SIGNER=CHANGE_ME_40_HEX_MANIFEST_SIGNER_FINGERPRINT
WALKSAFE_BACKUP_TRUSTED_SIGNER_FINGERPRINT=CHANGE_ME_40_HEX_MANIFEST_SIGNER_FINGERPRINT
WALKSAFE_BACKUP_KEY_CONTROL_DOCUMENT=/etc/walksafe/backup-key-control.json
WALKSAFE_BACKUP_KEY_CONTROL_SIGNATURE=/etc/walksafe/backup-key-control.json.sig
WALKSAFE_BACKUP_KEY_CONTROL_AUTHORITY_LOCK=/etc/walksafe/backup-key-control.lock
WALKSAFE_BACKUP_KEY_CONTROL_TRUSTED_SIGNER_FINGERPRINT=CHANGE_ME_40_HEX_CONTROL_SIGNER_FINGERPRINT
WALKSAFE_BACKUP_KEY_CONTROL_HEAD_SHA256=CHANGE_ME_64_HEX_KEY_CONTROL_SHA256
WALKSAFE_MAINTENANCE_LOCK_PATH=/run/walksafe-maintenance-lock/maintenance.lock
WALKSAFE_MAINTENANCE_LOCK_GROUP=walksafe-maintenance-lock
WALKSAFE_MAINTENANCE_LOCK_TIMEOUT_SECONDS=30
WALKSAFE_BACKEND_PYTHON=/srv/walksafe/backend/.venv/bin/python
WALKSAFE_BACKUP_ACTOR_ID=backup.oneshot
# Routine restore freshness is 26 hours. A reviewed recovery may raise this,
# but never beyond the canonical 35-day backup retention boundary (3024000).
WALKSAFE_BACKUP_MAX_AGE_SECONDS=93600
WALKSAFE_BACKUP_FUTURE_SKEW_SECONDS=300
