# Copy to /etc/walksafe/backend-migration.env, replace every CHANGE_ME value,
# set owner/group to root:root, and chmod 0600. Never make this
# file readable by the API service account or merge it into backend-runtime.env.
WALKSAFE_ENVIRONMENT=production
WALKSAFE_RUNTIME_DATABASE_ROLE=walksafe_backend_app
# This distinct, deployment-only non-superuser owns the public app schema, has
# CREATEROLE, and is never used by the API. FP-046 retains SET membership in its
# NOLOGIN receipt owner role so the same account can perform a safe downgrade.
WALKSAFE_MIGRATION_DATABASE_URL=postgresql+psycopg://walksafe_migrator:CHANGE_ME@db.example.invalid:5432/walksafe?sslmode=verify-full&gssencmode=disable

# Alembic needs these only when it binds legacy named-actor rows. Keep the value
# stable and identical to the runtime privacy key without exposing API database,
# TOTP, issuer, gateway, provider, or image-key credentials here.
WALKSAFE_PRIVACY_HMAC_SECRET=CHANGE_ME_RANDOM_PRIVACY_HMAC_SECRET_AT_LEAST_32_UTF8_BYTES
WALKSAFE_PRIVACY_HMAC_KEY_VERSION=1
