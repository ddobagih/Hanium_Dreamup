# Copy to /etc/walksafe/voice.env, replace CHANGE_ME, and chmod 0600.
WALKSAFE_ENVIRONMENT=production
VOICE_SERVICE_TOKEN=CHANGE_ME_DEDICATED_VOICE_TOKEN_AT_LEAST_24_CHARACTERS
# These comparison-only values make the Voice startup reject credential reuse.
WALKSAFE_FIELD_TEST_TOKEN=CHANGE_ME_BACKEND_FIELD_TOKEN
WALKSAFE_ADMIN_TOKEN=CHANGE_ME_BACKEND_ADMIN_TOKEN
WALKSAFE_GATEWAY_SESSION_SECRET=CHANGE_ME_WEB_SESSION_SECRET

# Voice limits are process-local. Production is intentionally one process/replica.
VOICE_SERVICE_WORKERS=1
VOICE_SERVICE_REPLICAS=1
VOICE_SERVICE_PROCESS_LOCK_PATH=/run/walksafe-voice/voice-process.lock
VOICE_CORS_ORIGINS=https://walksafe.example.invalid

VOICE_MAX_UPLOAD_BYTES=10485760
VOICE_STT_MAX_REQUEST_BYTES=11534336
VOICE_STT_MAX_AUDIO_DURATION_SECONDS=30
VOICE_STT_MAX_UPLOAD_CONCURRENCY=1
VOICE_STT_UPLOAD_QUEUE_TIMEOUT_SECONDS=2
VOICE_STT_ACTOR_RATE_LIMIT=12
VOICE_STT_IP_RATE_LIMIT=30
VOICE_STT_GLOBAL_RATE_LIMIT=120
VOICE_STT_RATE_WINDOW_SECONDS=60
VOICE_STT_MAX_CONCURRENCY=1
VOICE_STT_QUEUE_TIMEOUT_SECONDS=2
VOICE_STT_INFERENCE_TIMEOUT_SECONDS=30
VOICE_TTS_MAX_REQUEST_BYTES=4096
VOICE_TTS_ACTOR_RATE_LIMIT=30
VOICE_TTS_IP_RATE_LIMIT=60
VOICE_TTS_GLOBAL_RATE_LIMIT=120
VOICE_TTS_RATE_WINDOW_SECONDS=60
VOICE_TTS_MAX_CONCURRENCY=1
VOICE_TTS_QUEUE_TIMEOUT_SECONDS=2
VOICE_TTS_MAX_RESPONSE_BYTES=4194304
VOICE_TTS_MAX_AUDIO_DURATION_SECONDS=30
VOICE_TTS_INFERENCE_TIMEOUT_SECONDS=60
VOICE_READY_TIMEOUT_SECONDS=180

# STT/TTS model caches are external runtime inputs and are not in the RC archive.
# Provision only the exact Hugging Face snapshot named by each 40-hex commit.
# Each JSON manifest must use schema walksafe.voice_model_files.v1 and list every
# logical snapshot file as {"relative/path": "sha256"}; pin the manifest bytes too.
HF_HOME=/var/lib/walksafe/voice-model-cache
VOICE_STT_MODEL=Systran/faster-whisper-medium
VOICE_STT_MODEL_REVISION=CHANGE_ME_40_HEX_HF_COMMIT
VOICE_STT_MODEL_MANIFEST_PATH=/etc/walksafe/voice-stt-model-files.json
VOICE_STT_MODEL_MANIFEST_SHA256=CHANGE_ME_64_HEX_MANIFEST_SHA256
VOICE_STT_LANGUAGE=ko
VOICE_TTS_MODEL=Qwen/Qwen3-TTS-12Hz-0.6B-CustomVoice
VOICE_TTS_MODEL_REVISION=CHANGE_ME_40_HEX_HF_COMMIT
VOICE_TTS_MODEL_MANIFEST_PATH=/etc/walksafe/voice-tts-model-files.json
VOICE_TTS_MODEL_MANIFEST_SHA256=CHANGE_ME_64_HEX_MANIFEST_SHA256
VOICE_TTS_MODE=custom
VOICE_TTS_LANGUAGE=Korean
# Qwen3-TTS CustomVoice presets only. Sohee is the Korean-native preset.
VOICE_TTS_SPEAKER=Sohee
VOICE_TTS_CACHE_DIR=/var/cache/walksafe/voice/tts
VOICE_TTS_CACHE_MAX_FILES=256
VOICE_TTS_CACHE_MAX_BYTES=536870912
# Arbitrary user text is always transient and removed after the response. Only
# server-owned phrase_id requests may explicitly opt in to this bounded cache.
