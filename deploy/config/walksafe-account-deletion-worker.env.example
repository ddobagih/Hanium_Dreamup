# DRAFT MANUAL ONE-SHOT / NOT APPLIED.
# Install only as /etc/walksafe/account-deletion-worker.env with root:root
# ownership, mode 0600, one hard link, and no symlinked path component.
# Do not add DATABASE_URL, WALKSAFE_MIGRATION_DATABASE_URL, API credentials,
# administrator credentials, signing keys, or other application secrets.
WALKSAFE_ENVIRONMENT=staging
WALKSAFE_ACCOUNT_DELETION_TOPOLOGY=single-host-local-filesystem
WALKSAFE_ACCOUNT_DELETION_DATABASE_URL=postgresql+psycopg://walksafe_account_deletion_login:CHANGE_ME@db.example.invalid:5432/walksafe?sslmode=verify-full&gssencmode=disable
WALKSAFE_UPLOAD_BACKUP_READER_GROUP=walksafe-backup-readers
WALKSAFE_MAINTENANCE_LOCK_PATH=/run/walksafe-maintenance-lock/maintenance.lock
WALKSAFE_MAINTENANCE_LOCK_GROUP=walksafe-maintenance-lock
