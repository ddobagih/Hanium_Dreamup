{
  "schema_version": "walksafe.product-quality-policy.v2",
  "receipt_schema_version": "walksafe.product-quality-receipt.v3",
  "ambient_environment_allowlist": [
    "ANDROID_HOME",
    "ANDROID_SDK_ROOT",
    "CHROME_BIN",
    "JAVA_HOME",
    "LANG",
    "LC_ALL",
    "PATH",
    "TMPDIR",
    "TZ"
  ],
  "products": {
    "web": {
      "tested_environment_lock": null,
      "tested_tool_lock": "apps/web/quality-requirements.lock",
      "tested_site_packages": {
        "format": "walksafe.record-claimed-site-closure.v2",
        "closure": {
          "count": 609,
          "sha256": "3c4af3938cf097949d992257ba9716b28a026ef627f1480e98b79087f8a30a55"
        }
      },
      "trusted_tool_distributions": {
        "pip": "26.1.1"
      },
      "required_arguments": [
        "web_release_archive"
      ],
      "steps": [
        {
          "id": "npm-ci",
          "argv": [
            "npm",
            "ci"
          ],
          "cwd": "apps/web"
        },
        {
          "id": "npm-audit",
          "argv": [
            "npm",
            "audit",
            "--audit-level=moderate"
          ],
          "cwd": "apps/web"
        },
        {
          "id": "npm-lint",
          "argv": [
            "npm",
            "run",
            "lint"
          ],
          "cwd": "apps/web"
        },
        {
          "id": "npm-typecheck",
          "argv": [
            "npm",
            "run",
            "typecheck"
          ],
          "cwd": "apps/web"
        },
        {
          "id": "npm-test",
          "argv": [
            "npm",
            "test"
          ],
          "cwd": "apps/web"
        },
        {
          "id": "npm-build",
          "argv": [
            "npm",
            "run",
            "build"
          ],
          "cwd": "apps/web",
          "fixed_environment": {
            "NEXT_PUBLIC_DETECTOR_MODE": "server-v2",
            "NEXT_PUBLIC_WALKSAFE_PWA_ENABLED": "true",
            "NEXT_PUBLIC_WALKSAFE_SUPERVISED_TACTILE_LOCAL_STEERING": "false",
            "NEXT_PUBLIC_WALKSAFE_TEST_CAPTURE_PANEL": "false",
            "WALKSAFE_SOURCE_COMMIT": "{source_commit}"
          }
        },
        {
          "id": "runtime-trace",
          "argv": [
            "{python}",
            "-I",
            "-S",
            "-B",
            "scripts/run_walksafe_isolated_python_20260713.py",
            "--repo-root",
            ".",
            "--product",
            "web",
            "--",
            "scripts/check_web_runtime_trace_scope_20260713.py"
          ],
          "cwd": ".",
          "fixed_environment": {
            "PYTHONDONTWRITEBYTECODE": "1"
          }
        },
        {
          "id": "browser-lifecycle",
          "argv": [
            "{python}",
            "-I",
            "-S",
            "-B",
            "scripts/run_walksafe_isolated_python_20260713.py",
            "--repo-root",
            ".",
            "--product",
            "web",
            "--",
            "scripts/check_pwa_browser_lifecycle_20260711.py",
            "--existing-build-dir",
            ".next"
          ],
          "cwd": ".",
          "fixed_environment": {
            "PYTHONDONTWRITEBYTECODE": "1",
            "WALKSAFE_SOURCE_COMMIT": "{source_commit}"
          }
        }
      ],
      "outputs": [
        {
          "name": "web_release_archive",
          "path_argument": "web_release_archive",
          "verification_step": "npm-build",
          "verification": "fresh-next-standalone-content-with-validated-build-variance-v2"
        }
      ]
    },
    "android": {
      "tested_environment_lock": null,
      "tested_tool_lock": null,
      "tested_site_packages": null,
      "trusted_tool_distributions": {},
      "required_arguments": [
        "android_gateway_origin"
      ],
      "steps": [
        {
          "id": "unit-test",
          "argv": [
            "./gradlew",
            "testDebugUnitTest",
            "--no-daemon"
          ],
          "cwd": "apps/android"
        },
        {
          "id": "lint-release",
          "argv": [
            "./gradlew",
            "lintRelease",
            "--no-daemon"
          ],
          "cwd": "apps/android",
          "fixed_environment": {
            "WALKSAFE_GATEWAY_ORIGIN": "{android_gateway_origin}",
            "WALKSAFE_SOURCE_COMMIT": "{source_commit}"
          }
        },
        {
          "id": "assemble-release",
          "argv": [
            "./gradlew",
            "assembleRelease",
            "--no-daemon"
          ],
          "cwd": "apps/android",
          "fixed_environment": {
            "WALKSAFE_GATEWAY_ORIGIN": "{android_gateway_origin}",
            "WALKSAFE_SOURCE_COMMIT": "{source_commit}"
          }
        },
        {
          "id": "apk-model-asset",
          "argv": [
            "{python}",
            "-I",
            "-S",
            "-B",
            "scripts/run_walksafe_isolated_python_20260713.py",
            "--repo-root",
            ".",
            "--product",
            "android",
            "--",
            "scripts/check_android_apk_model_asset_20260713.py",
            "--apk",
            "apps/android/app/build/outputs/apk/release/app-release-unsigned.apk"
          ],
          "cwd": ".",
          "fixed_environment": {
            "PYTHONDONTWRITEBYTECODE": "1"
          }
        }
      ],
      "outputs": [
        {
          "name": "unsigned_apk",
          "path": "apps/android/app/build/outputs/apk/release/app-release-unsigned.apk",
          "producer_step": "assemble-release",
          "verification": "fresh-gradle-assemble-output-v1"
        }
      ]
    },
