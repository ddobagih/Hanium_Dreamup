# Development/test example only; do not copy it to field/staging/production.
# Deployment uses separate root:root 0600 runtime and migration env files under /etc/walksafe.
# Set an application-specific user and a strong password; do not reuse the example text.
# Remote field/staging/production databases must use sslmode=verify-full and gssencmode=disable.
# Plain connections are accepted only over loopback or a Unix socket.
DATABASE_URL=postgresql+psycopg://walksafe_app:CHANGE_ME@127.0.0.1:5432/walksafe
# Optional local Alembic override; deployment uses a separate
# /etc/walksafe/backend-migration.env. It must be distinct from DATABASE_URL.
WALKSAFE_MIGRATION_DATABASE_URL=
DATABASE_CONNECT_TIMEOUT_SECONDS=5
DATABASE_STATEMENT_TIMEOUT_MS=10000
# Deployment startup treats these as operator declarations, not external proof.
# Keep the two non-secret boundary identifiers distinct; cloud/KMS verification
# remains a separate operational gate.
WALKSAFE_DATABASE_AT_REST_ENCRYPTION_CONFIRMED=false
WALKSAFE_DATABASE_TRANSPORT_SECURITY_CONFIRMED=false
WALKSAFE_DATABASE_ENCRYPTION_KEY_BOUNDARY=
WALKSAFE_REPORT_IMAGE_KEY_BOUNDARY=
# docker compose reads these separately; keep them consistent with DATABASE_URL.
POSTGRES_DB=walksafe
POSTGRES_USER=walksafe_app
POSTGRES_PASSWORD=CHANGE_ME
# pytest refuses live database names. Provision a separate PostGIS database whose name contains "test".
WALKSAFE_TEST_DATABASE_URL=postgresql+psycopg://walksafe_test:CHANGE_ME@127.0.0.1:5432/walksafe_test
UPLOAD_DIR=backend/uploads
MAX_UPLOAD_BYTES=8388608
ALLOWED_IMAGE_CONTENT_TYPES=image/jpeg,image/png,image/webp
# No raw image key is accepted through environment variables. Choose exactly
# one external provider. In deployment, secret_file must be a root-owned,
# single-link 0440/0640 file whose group is the backend service's primary GID;
# every ancestor must be root-owned and non-writable. kms_agent must run under
# a UID different from the backend and expose a protected AF_UNIX socket.
WALKSAFE_REPORT_IMAGE_KEY_PROVIDER=secret_file
WALKSAFE_REPORT_IMAGE_KEY_FILE=/etc/walksafe/report-image-keyring.json
WALKSAFE_REPORT_IMAGE_KMS_AGENT_SOCKET=
WALKSAFE_REPORT_IMAGE_KMS_AGENT_PEER_UID=0
WALKSAFE_REPORT_IMAGE_KMS_AGENT_TIMEOUT_SECONDS=2.0
WALKSAFE_REPORT_ORIGINAL_GRANT_TTL_SECONDS=120
MODEL_ARTIFACT_PATH=
MODEL_VERSION=
MODEL_CLASS_ORDER=damaged_tactile_block,parked_kickboard_bicycle,construction_obstacle,pothole
MODEL_CONFIDENCE_THRESHOLD=0.35
MODEL_IOU_THRESHOLD=0.7
MODEL_IMAGE_SIZE=640
DETECT_V2_MODE=real
DETECT_V2_IMAGE_SIZE=768
DETECT_V2_CUSTOM_TACTILE_MODEL_PATH=
DETECT_V2_COCO_MODEL_PATH=
DETECT_V2_UNIFIED_MODEL_PATH=model/artifacts/candidates/walksafe_13cls_yolo26n_img768_20260708/walksafe_13cls_yolo26n_img768_best_epoch270.pt
DETECT_V2_RUNTIME_CONFIG_PATH=configs/walksafe_unified_epoch270_field_20260711.json
INFERENCE_PROCESS_ISOLATION_ENABLED=true
INFERENCE_TIMEOUT_SECONDS=2.0
INFERENCE_STARTUP_TIMEOUT_SECONDS=30.0
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
WALKING_ROUTE_PROVIDER=tmap_pedestrian
TMAP_APP_KEY=
TMAP_PEDESTRIAN_ROUTE_URL=https://apis.openapi.sk.com/tmap/routes/pedestrian
TMAP_PEDESTRIAN_API_VERSION=1
TMAP_POI_SEARCH_URL=https://apis.openapi.sk.com/tmap/pois
TMAP_POI_PROVIDER=live
TMAP_TIMEOUT_SECONDS=4.0
TMAP_READINESS_LIVE_PROBE_ENABLED=false
TMAP_READINESS_PROBE_TIMEOUT_SECONDS=3.0
TMAP_READINESS_SUCCESS_MAX_AGE_SECONDS=300
TMAP_PEDESTRIAN_SPEED_KMH=4.0
MAX_REPORT_METADATA_BYTES=65536
ANDROID_DEBUG_LOG_ENABLED=false
ANDROID_DEBUG_LOG_DIR=backend/android_debug_logs
MAX_ANDROID_DEBUG_LOG_BYTES=65536
ANDROID_DEBUG_LOG_RETENTION_DAYS=7
WALKSAFE_ENVIRONMENT=development
WALKSAFE_BACKEND_WORKERS=1
WALKSAFE_BACKEND_REPLICAS=1
# field/staging/production require PostgreSQL so all workers and replicas share
# one atomic actor request budget. memory is accepted only for development/test.
WALKSAFE_ACTOR_RATE_LIMIT_STORE=memory
WALKSAFE_SOURCE_COMMIT=
WALKSAFE_MAINTENANCE_LOCK_PATH=
WALKSAFE_BACKUP_TRUSTED_SIGNER_FINGERPRINT=
WALKSAFE_RESTORE_GPG_SIGNER=
WALKSAFE_RESTORE_TRUSTED_SIGNER_FINGERPRINT=
WALKSAFE_ALLOW_INSECURE_LOCAL_DEV=false
WALKSAFE_FIELD_TEST_SECURITY_ENABLED=true
WALKSAFE_FIELD_TEST_TOKEN=
WALKSAFE_ADMIN_TOKEN=
WALKSAFE_GATEWAY_SESSION_SECRET=
# Dedicated HMAC key for pseudonymous privacy subjects and deletion capability
# binding. Alembic also uses it to bind legacy named-actor reports before raw
# actor metadata is removed. Use at least 32 UTF-8 bytes, and do not reuse or
# change it between migration/runtime.
WALKSAFE_PRIVACY_HMAC_SECRET=
# Increment only as part of an explicit migration/keyring rotation procedure.
WALKSAFE_PRIVACY_HMAC_KEY_VERSION=1
# field/staging/production must enable this database-backed administrator mode.
# WALKSAFE_ADMIN_TOKEN is legacy-only and cannot bypass this mode when enabled.
WALKSAFE_ADMIN_SECURITY_ENABLED=false
WALKSAFE_ADMIN_ID=walksafe.admin
# Generate an unpadded Base32 seed with at least 160 bits (for example,
# pyotp.random_base32()). Store it outside the database and never commit it.
WALKSAFE_ADMIN_TOTP_SECRET=
# Required when the database-backed administrator mode issues credentials.
# Store a separate canonical 43-character unpadded base64url 256-bit key in a
# private file; never place the key value in this environment file.
WALKSAFE_ADMIN_CREDENTIAL_ISSUER_KEY_FILE=
WALKSAFE_ADMIN_SESSION_TTL_SECONDS=43200
WALKSAFE_ADMIN_STEP_UP_TTL_SECONDS=300
WALKSAFE_ADMIN_RECOVERY_TTL_SECONDS=900
# Per-source limit. An account-wide limit at four times this value also applies.
WALKSAFE_ADMIN_AUTH_RATE_LIMIT_ATTEMPTS=5
WALKSAFE_ADMIN_AUTH_RATE_LIMIT_WINDOW_SECONDS=300
